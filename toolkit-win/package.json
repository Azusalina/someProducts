{
  "name": "toolkit-win",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local modular live file preview and manual PDF export",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "test:pdf": "node tests/pdf.js",
    "test:tabs": "node tests/tabs.js",
    "test:pdf-pages": "node tests/pdf-pages-browser.js",
    "test:photos": "node tests/photos-browser.js",
    "media:setup": "node scripts/python.mjs scripts/setup-media.py",
    "test:media": "node scripts/python.mjs --venv .venv-media tests/test_media.py && node tests/media-browser.js",
    "pdfmd:setup": "node scripts/python.mjs scripts/setup-pdfmd.py",
    "autostart:install": "node scripts/autostart.mjs install",
    "autostart:remove": "node scripts/autostart.mjs uninstall",
    "test:pdfmd": "node tests/pdfmd-browser.js",
    "formats:setup": "node scripts/python.mjs scripts/setup-formats.py",
    "test:formats": "node scripts/python.mjs --venv .venv-formats tests/test_photo_formats.py && node tests/formats-browser.js",
    "test:tex": "node tests/tex-browser.js",
    "test:flowchart": "node tests/flowchart-browser.js",
    "scribd:setup": "node scripts/python.mjs scripts/setup-scribd.py",
    "test:scribd": "node scripts/python.mjs --venv .venv-scribd tests/test_scribd.py && node tests/scribd-browser.js",
    "doctor": "node scripts/doctor.mjs",
    "browser:setup": "playwright-core install chromium",
    "test:firefox": "node tests/flowchart-browser.js --firefox",
    "ffmpeg:setup": "node scripts/setup-ffmpeg.mjs",
    "postinstall": "node scripts/build-renderer.mjs",
    "build:renderer": "node scripts/build-renderer.mjs"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1"
  }
}
